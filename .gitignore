# dependencies
node_modules
.pnp
.pnp.js
.yarn/install-state.gz

# testing
coverage

# production
dist
dist-ssr
*.local

# logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Tauri
src-tauri/target/
src-tauri/gen/
# NOTE: src-tauri/icons/ is committed (auto-generated by scripts/generate-icons.py
#       but required for builds — keeping them in git makes "git clone -> build" work)

# Python sidecar
sidecar/venv/
sidecar/__pycache__/
sidecar/*.egg-info/
sidecar/dist/
sidecar/build/
# Keep redforge-sidecar.spec in git (it's the production build recipe).
# Other generated *.spec files (from `pyinstaller foo.py`) stay ignored:
sidecar/*.spec
!sidecar/redforge-sidecar.spec

# User data (never commit real operations)
data/
*.db
*.sqlite
operations/
evidence/

# ATT&CK data (large - download on demand or use git-lfs)
**/enterprise-attack*.json
**/attack-stix-data/

# OS
Thumbs.db

# one-time publish helper (token script)
push-to-github.sh

# One-click launcher state
.redforge-setup-done
sidecar/.venv/
