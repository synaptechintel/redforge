{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions required for RedForge - sidecar control, shell, updater, process",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "core:event:default",
    "core:image:default",
    "core:menu:default",
    "core:resources:default",
    "core:tray:default",
    "core:path:default",
    "shell:allow-open",
    "updater:default",
    "process:default"
  ]
}
